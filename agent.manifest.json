{
  "agent_type": "market_news",
  "display_name": "Market News Analyzer",
  "version": "0.1.0",
  "description": "Analyzes recent market news for any stock ticker using web search and LLM sentiment analysis",
  "taxonomy": {
    "domain": ["finance", "market"],
    "tasks": ["news_analysis", "sentiment_analysis", "market_research"],
    "tags": ["stock", "news", "sentiment", "ticker", "finance", "market", "equities"],
    "input_schema": {
      "ticker": { "type": "string", "description": "Stock ticker symbol (e.g. AAPL, TSLA)" },
      "days":   { "type": "integer", "description": "Number of days to look back", "default": 7 }
    },
    "output_schema": {
      "ticker":     { "type": "string" },
      "summary":    { "type": "string", "description": "2-3 sentence overall summary" },
      "sentiment":  { "type": "string", "enum": ["bullish", "bearish", "neutral"] },
      "key_points": { "type": "array",  "items": { "type": "string" } },
      "sources":    { "type": "array",  "items": { "type": "string", "format": "uri" } }
    }
  },
  "compute": {
    "tier": "cpu",
    "cpu": "0.5",
    "memory": "512Mi"
  },
  "compute_provider": "platform",
  "default_config": { "days": 7 },
  "well_known_path": "/.well-known/agent.json"
}
